# /etc/caddy/Caddyfile — automatic HTTPS (Let's Encrypt) for the API. The website itself is on Cloudflare Pages.
{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 6MB
	}
	# product images uploaded by staff (UPLOAD_DRIVER=local); long cache, never executable
	handle_path /uploads/* {
		root * /srv/source-connect/uploads
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		@notimg not path *.jpg *.png *.webp
		respond @notimg 404
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:8080 {
			health_uri /health
			health_interval 15s
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output file /var/log/caddy/api-access.log {
			roll_size 20MiB
			roll_keep 10
		}
		format json
	}
}
