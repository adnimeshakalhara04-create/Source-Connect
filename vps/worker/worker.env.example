# /etc/source-connect/worker.env  (owner root, group sc-worker, mode 0640). NEVER commit the real file.
# Database: the least-privilege sc_worker role through the Supabase session pooler (port 5432).
# Username format on the pooler is sc_worker.<project-ref>. The password is generated on the VPS
# (openssl rand -base64 32) and set once in the Supabase SQL editor: ALTER ROLE sc_worker WITH LOGIN PASSWORD '...';
DATABASE_URL=postgresql://sc_worker.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=require

# Storage access for product photo checks (service role key: server-side only, never in the website).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Email: none (jobs wait in the queue) | smtp | file (staging: writes messages to OUTBOX_DIR)
EMAIL_TRANSPORT=none
SMTP_URL=
EMAIL_FROM=Source Connect Global <orders@your-domain>
SITE_URL=https://your-domain

SNAPSHOT_DIR=/var/lib/source-connect/catalog
OUTBOX_DIR=/var/lib/source-connect/outbox
