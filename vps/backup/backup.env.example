# /etc/source-connect/backup.env  (root:root, mode 0600). NEVER commit the real file. NEVER paste its values into chat.

# Read access to the whole database for pg_dump: the Supabase "postgres" role through the SESSION pooler (port 5432).
# Dashboard -> Connect -> Session pooler. Username format: postgres.<project-ref>
BACKUP_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Least-privilege role used only to write backup status for the admin Backups page (same as the worker's DATABASE_URL)
WORKER_DATABASE_URL=postgresql://sc_worker.<project-ref>:<worker-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

BACKUP_DIR=/var/backups/source-connect
LOCAL_KEEP_DAYS=7
PG_DUMP=/usr/lib/postgresql/17/bin/pg_dump
PSQL=/usr/lib/postgresql/17/bin/psql

# age encryption. recipients = PUBLIC keys (one per line): the VPS drill key + the owner's offline key.
# identity = the drill key's PRIVATE part, needed only by the weekly restore drill (root-only file, mode 0600).
AGE_RECIPIENTS_FILE=/etc/source-connect/backup-recipients.txt
AGE_IDENTITY_FILE=/etc/source-connect/drill-age.key

# rclone remotes defined in /etc/source-connect/rclone.conf (mode 0600):
#   r2       = Cloudflare R2 (S3 API token limited to the backup bucket)
#   r2crypt  = crypt remote on top of r2:<bucket>/files (encrypted photo copies)
#   supabase = Supabase Storage S3 protocol (Dashboard -> Storage -> S3 access keys; read is enough)
RCLONE_CONFIG=/etc/source-connect/rclone.conf
R2_DB_REMOTE=r2:sc-backups
R2_STORAGE_REMOTE=r2crypt:
SUPABASE_S3_REMOTE=supabase:
STORAGE_BUCKETS=product-images
CATALOG_DIR=/var/lib/source-connect/catalog

# Restore drill: same Postgres image family as the hosted project (check the version in Dashboard -> Settings -> Infrastructure)
SCRATCH_IMAGE=public.ecr.aws/supabase/postgres:17.11.0.006

# Optional dead man's switch URLs (alert when pings STOP), and alert channel (see infra/backup/alert.sh)
DB_BACKUP_PING_URL=
STORAGE_BACKUP_PING_URL=
RESTORE_DRILL_PING_URL=
ALERT=/opt/source-connect/infra/backup/alert.sh
