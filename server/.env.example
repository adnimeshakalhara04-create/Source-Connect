# Source Connect API — example settings. Copy to `.env` on the server and fill in.
# NEVER commit the real .env. Never put these values in the website/admin JavaScript.

NODE_ENV=production
HOST=127.0.0.1
PORT=8080

# PostgreSQL (listens on localhost only). Use a strong random password.
DATABASE_URL=postgres://sc_app:CHANGE_ME@127.0.0.1:5432/source_connect
DATABASE_POOL_MAX=10

# Public addresses
PUBLIC_API_URL=https://api.example.lk
PUBLIC_SITE_URL=https://www.example.lk
CORS_ORIGINS=https://www.example.lk,https://example.lk

# Cookies (HTTPS only in production). Share the parent domain so the site and API are same-site.
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
COOKIE_DOMAIN=
TRUST_PROXY=true

# Sessions and stock holds
STAFF_SESSION_HOURS=12
CUSTOMER_SESSION_DAYS=30
RESERVATION_MINUTES=30
BANK_RESERVATION_HOURS=48

# PayHere — SANDBOX first. Live needs the owner's written approval:
# set PAYHERE_MODE=live AND PAYHERE_LIVE_APPROVED=true only after sign-off.
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_LIVE_APPROVED=false

# Product images: local disk (served by Caddy) or an S3-compatible bucket such as Cloudflare R2
UPLOAD_DRIVER=local
UPLOAD_DIR=/srv/source-connect/uploads
PUBLIC_UPLOAD_URL=https://api.example.lk/uploads
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=source-connect-images
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

ENABLE_API_DOCS=false
LOG_LEVEL=info
BACKUP_MAX_AGE_HOURS=26
